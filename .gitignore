# ===================================================================
# Default .gitignore for Spring Boot + Maven projects
# ===================================================================

# Build output folders
# These are the compiled files and packages generated by Maven/Gradle.
# They can be rebuilt from the source code, so they should never be committed.
/target/
/build/

# IDE-specific files and folders
# These files are for your local IDE setup and will be different for each developer.
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/

# Compiled Java class files
*.class

# Log files
# Logs are generated during runtime and are not part of the source code.
*.log
logs/

# Packaged artifacts
# JAR/WAR files are the final product, not the source code.
*.jar
*.war
*.ear

# JVM crash logs
hs_err_pid*

# Operating System files (macOS, Windows)
.DS_Store
Thumbs.db

# Sensitive Information - VERY IMPORTANT!
# Any file containing local passwords, API keys, or other secrets.
# While we are tracking application.progit perties for this simple project,
# in a real-world scenario you would use an ignored file for secrets.
application-local.properties
.env
 backend/src/main/resources/application.properties